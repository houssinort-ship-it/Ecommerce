# Copiez ce fichier en .env (optionnel, sinon http://localhost:4000/api est utilisé)
# En production, si VITE_API_URL est absent, le front appelle /api sur son propre
# domaine. Définissez-la si l'API est hébergée sur un autre domaine (Vercel).
VITE_API_URL=http://localhost:4000/api

# URL du serveur MCP (optionnel).
# Par défaut, elle est déduite de VITE_API_URL : http://localhost:4000/api -> http://localhost:4000/mcp
# VITE_MCP_URL=http://localhost:4000/mcp
