# Copiez ce fichier en .env et remplissez les valeurs (ne commitez jamais .env)
PORT=4000

# Chaîne de connexion MongoDB Atlas (ou locale)
DATABASE_CLOUD=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/<nom_base>

# Secret de signature des JWT : chaîne aléatoire longue (ex: openssl rand -hex 32)
JWT_SECRET=changez_moi_avec_une_chaine_aleatoire_de_64_caracteres

# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# URL de l'API utilisée par les tools du serveur MCP (doit pointer vers CE serveur).
# http://localhost:4000/api en local ; https://<votre-app>.vercel.app/api en production.
# Si la variable est absente, le serveur utilise http://localhost:${PORT}/api.
API_URL=http://localhost:4000/api

# Clé partagée permettant au serveur MCP d'appeler les routes protégées (POST/PUT/DELETE).
# Chaîne aléatoire longue (ex: openssl rand -hex 24). Obligatoire pour les tools d'écriture.
MCP_API_KEY=changez_moi_avec_une_chaine_aleatoire

# Protection optionnelle de l'endpoint public /mcp (recommandé dès qu'il est exposé
# sur Internet via Vercel, ngrok, cloudflared...).
# Si elle est définie, le client doit fournir le jeton :
#   - Authorization: Bearer <jeton>
#   - en-tête x-mcp-token: <jeton>
#   - ou paramètre d'URL ?token=<jeton>  (le plus simple pour ChatGPT)
# Laissez vide en local pour désactiver la protection.
MCP_ACCESS_TOKEN=
